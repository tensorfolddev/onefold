# Copy to .env.local for development (it's git-ignored). Staging and production keep their own on the VPS.

# Which pipeline this build is for: dev | stg | prod. dev and stg show a badge on every screen.
NEXT_PUBLIC_APP_ENV=dev

# The address people use. Invite links are built from it.
APP_URL=http://localhost:3000

# The app's own database login (restricted: rows only, row-level security always on).
DATABASE_URL=postgres://onefold_web:change-me@127.0.0.1:5433/onefold
# The database owner — used only by `npm run db:migrate`, never by the running app.
DATABASE_ADMIN_URL=postgres://onefold_admin:change-me@127.0.0.1:5433/onefold

# Signs the route cookie. 32+ random characters, different per environment: `openssl rand -base64 36`
SESSION_SECRET=

# Email through Resend (resend.com → API Keys). Staging and production each use their own Resend account, sending from
# a domain verified there. Without a key nothing is sent: development prints each email to the server log.
RESEND_API_KEY=
EMAIL_FROM=1Fold <no-reply@tensorfold.ai>
